;;-*-Lisp-*-
;; goal2c (Jak Vita): casos de engine/math/vector-h.gc (goalc x86 frente a goal2c).
;; Usa las macros de cases_prelude.gc. Comparación bit a bit.
;; Los inspect/print de vector-h imprimen la dirección del objeto: no se llaman.

(define *g2c-vh-a* (new 'global 'vector))
(define *g2c-vh-b* (new 'global 'vector))
(define *g2c-vh-o* (new 'global 'vector))
(define *g2c-bits* (new 'global 'bit-array 77))

(defun g2c-vector-h-cases ()
  (g2c-set! *g2c-vh-a* 1.5 -2.0 3.25 4.0)
  (g2c-set! *g2c-vh-b* -0.5 8.0 0.125 -3.0)
  ;; productos escalares (3 y 4 componentes, versión vu y normal)
  (g2c-pf "dot" (vector-dot *g2c-vh-a* *g2c-vh-b*))
  (g2c-pf "dot-vu" (vector-dot-vu *g2c-vh-a* *g2c-vh-b*))
  (g2c-pf "dot4" (vector4-dot *g2c-vh-a* *g2c-vh-b*))
  (g2c-pf "dot4-vu" (vector4-dot-vu *g2c-vh-a* *g2c-vh-b*))
  (g2c-set! *g2c-vh-a* 100000000000000000000.0 -0.00000000000000000003 7.0 -1000000000000000000000000000000.0)
  (g2c-set! *g2c-vh-b* 100000000000000000000.0 50000000000000000000.0 -0.0 2.0)
  (g2c-pf "dot-grande" (vector-dot *g2c-vh-a* *g2c-vh-b*))
  (g2c-pf "dot4-grande" (vector4-dot *g2c-vh-a* *g2c-vh-b*))
  ;; suma, resta, copia, cero, reset (w se conserva o se fija según la función)
  (g2c-set! *g2c-vh-a* 1.5 -2.0 3.25 4.0)
  (g2c-set! *g2c-vh-b* -0.5 8.0 0.125 -3.0)
  (g2c-set! *g2c-vh-o* 9.0 9.0 9.0 9.0)
  (g2c-pv "+" (vector+! *g2c-vh-o* *g2c-vh-a* *g2c-vh-b*))
  (g2c-set! *g2c-vh-o* 9.0 9.0 9.0 9.0)
  (g2c-pv "-" (vector-! *g2c-vh-o* *g2c-vh-a* *g2c-vh-b*))
  (g2c-pv "copy" (vector-copy! *g2c-vh-o* *g2c-vh-b*))
  (g2c-pv "zero" (vector-zero! *g2c-vh-o*))
  (g2c-set! *g2c-vh-o* 9.0 9.0 9.0 9.0)
  (g2c-pv "reset" (vector-reset! *g2c-vh-o*))
  ;; bit-array
  (let ((ba *g2c-bits*))
    (g2c-pi "bits-length" (length ba))
    (g2c-pi "bits-asize" (asize-of ba))
    (clear-all! ba)
    (set-bit ba 0)
    (set-bit ba 9)
    (set-bit ba 63)
    (set-bit ba 76)
    (g2c-pb "bit0" (get-bit ba 0))
    (g2c-pb "bit1" (get-bit ba 1))
    (g2c-pb "bit9" (get-bit ba 9))
    (g2c-pb "bit63" (get-bit ba 63))
    (g2c-pb "bit76" (get-bit ba 76))
    (g2c-pi "byte1" (-> ba bytes 1))
    (g2c-pi "byte7" (-> ba bytes 7))
    (clear-bit ba 9)
    (g2c-pb "bit9-borrado" (get-bit ba 9))
    (g2c-pi "byte1-borrado" (-> ba bytes 1))
    (clear-all! ba)
    (g2c-pb "bit76-tras-clear" (get-bit ba 76))
    (g2c-pi "byte9-tras-clear" (-> ba bytes 9))))

(g2c-vector-h-cases)
