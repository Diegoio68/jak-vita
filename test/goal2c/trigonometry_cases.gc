;;-*-Lisp-*-
;; goal2c (Jak Vita): casos de engine/math/trigonometry.gc (goalc x86 frente a goal2c en el juego).
;; Usa las macros de cases_prelude.gc (el test lo antepone). Comparación bit a bit.
;; Ángulos en grados GOAL (65536 = vuelta completa) salvo las funciones -rad.

(define *g2c-ta* (new 'global 'vector))
(define *g2c-tb* (new 'global 'vector))
(define *g2c-tc* (new 'global 'vector))

(defun g2c-trig-reset ()
  (g2c-set! *g2c-ta* 0.5 -1.25 3.0 -0.1)
  (g2c-set! *g2c-tb* 77.0 77.0 77.0 77.0)
  (g2c-set! *g2c-tc* 88.0 88.0 88.0 88.0)
  0)

(defmacro g2c-pf-all (tag fn)
  "aplica una función de un float a varios valores representativos"
  `(begin
     (g2c-pf ,tag (,fn 0.0))
     (g2c-pf ,tag (,fn 1.0))
     (g2c-pf ,tag (,fn -0.5))
     (g2c-pf ,tag (,fn 8192.0))
     (g2c-pf ,tag (,fn -30000.0))
     (g2c-pf ,tag (,fn 70000.0))
     (g2c-pf ,tag (,fn 0.75))))

(defun g2c-trigonometry-cases ()
  (let ((a *g2c-ta*) (b *g2c-tb*) (c *g2c-tc*))
    (g2c-pf-all "radmod" radmod)
    (g2c-pf "radmod-big" (radmod 100.0))
    (g2c-pf "deg-" (deg- 1000.0 60000.0))
    (g2c-pf "deg-2" (deg- -30000.0 30000.0))
    (g2c-pf "deg-diff" (deg-diff 1000.0 60000.0))
    (g2c-pf "deg-diff2" (deg-diff 60000.0 1000.0))
    (g2c-pf "deg-seek" (deg-seek 1000.0 60000.0 500.0))
    (g2c-pf "deg-seek2" (deg-seek 1000.0 1200.0 500.0))
    (g2c-pf "deg-seek-smooth" (deg-seek-smooth 1000.0 60000.0 500.0 0.25))
    (g2c-pf "deg-lerp-clamp" (deg-lerp-clamp 1000.0 60000.0 0.3))
    (g2c-pf "deg-lerp-clamp2" (deg-lerp-clamp 1000.0 60000.0 1.5))
    (g2c-pf-all "sin" sin)
    (g2c-pf-all "sin-rad" sin-rad)
    (g2c-pf-all "cos" cos)
    (g2c-pf-all "cos-rad" cos-rad)
    (g2c-pf-all "tan" tan)
    (g2c-pf-all "tan-rad" tan-rad)
    (g2c-pf-all "atan-series-rad" atan-series-rad)
    (g2c-pf-all "atan-rad" atan-rad)
    (g2c-pf-all "sign" sign)
    (g2c-pf-all "exp" exp)
    (g2c-pf "asin" (asin 0.5))
    (g2c-pf "asin-1" (asin -1.0))
    (g2c-pf "asin-fuera" (asin 1.5))
    (g2c-pf "acos" (acos 0.5))
    (g2c-pf "acos-1" (acos -1.0))
    (g2c-pf "acos-rad" (acos-rad 0.25))
    (g2c-pf "atan0" (atan0 1.0 2.0))
    (g2c-pf "atan0-neg" (atan0 -3.0 0.5))
    (g2c-pf "atan2-rad" (atan2-rad 1.0 -2.0))
    (g2c-pf "atan2-rad-0" (atan2-rad 0.0 0.0))
    (g2c-pf "atan" (atan 1.0 2.0))
    (g2c-pf "atan-cuadrantes" (atan -1.0 -2.0))
    (g2c-pf "atan-0" (atan 0.0 0.0))
    (g2c-trig-reset) (g2c-pv "vector-sin-rad" (vector-sin-rad! b a))
    (g2c-trig-reset) (g2c-pv "vector-cos-rad" (vector-cos-rad! b a))
    (g2c-trig-reset) (vector-sincos-rad! b c a) (g2c-pv "vector-sincos-rad-s" b) (g2c-pv "vector-sincos-rad-c" c)
    (g2c-trig-reset) (sincos-rad! (the-as (pointer float) b) 0.7) (g2c-pv "sincos-rad" b)
    (g2c-trig-reset) (sincos! (the-as (pointer float) b) 12000.0) (g2c-pv "sincos" b)
    ;; devuelve none: se imprime su salida
    (g2c-trig-reset) (vector-rad<-vector-deg! b (g2c-set! c 8192.0 -16384.0 1000.0 0.0))
    (g2c-pv "rad<-deg" b)
    (g2c-trig-reset) (vector-rad<-vector-deg/2! b (g2c-set! c 8192.0 -16384.0 1000.0 0.0))
    (g2c-pv "rad<-deg/2" b)
    (g2c-trig-reset) (vector-sincos! b c (g2c-set! a 8192.0 -16384.0 1000.0 40000.0))
    (g2c-pv "vector-sincos-s" b) (g2c-pv "vector-sincos-c" c)
    (g2c-pf "sinerp" (sinerp 1.0 5.0 0.3))
    (g2c-pf "sinerp-clamp" (sinerp-clamp 1.0 5.0 1.3))
    (g2c-pf "coserp" (coserp 1.0 5.0 0.3))
    (g2c-pf "coserp-clamp" (coserp-clamp 1.0 5.0 -0.3))
    (g2c-pf "coserp180" (coserp180 1.0 5.0 0.3))
    (g2c-pf "coserp180-clamp" (coserp180-clamp 1.0 5.0 2.0))
    (g2c-pf "ease-in-out" (ease-in-out 100 10))
    (g2c-pf "ease-in-out2" (ease-in-out 100 50))
    (g2c-pf "ease-in-out3" (ease-in-out 100 95)))
  0)

(g2c-trigonometry-cases)
