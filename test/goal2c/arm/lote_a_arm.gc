;;-*-Lisp-*-
;; goal2c (Jak Vita): casos de comprobación en ARM del lote A (engine/gfx, draw, dma, ps2,
;; engine, data, physics). Ver arm_prelude.gc (el test lo antepone).
;; Funciones de cálculo: tablas de formatos GS, tamaños de textura, buffers DMA, paquetes GIF,
;; matrices del océano, luces, cuaterniones de sprites, dinámica, transformación de puntos y
;; recorte contra el frustum de *math-camera* (global de la imagen grabada).

(defun g2c-basic-alloc ((size int) (type type))
  "un basic en la arena: etiqueta de tipo y objeto 4 bytes después"
  (let ((p (g2c-alloc size)))
    (set! (-> (the-as (pointer type) p)) type)
    (&+ p 4)))

(define *g2c-psms* (new 'static 'array int32 10 0 1 2 10 19 20 27 36 44 48))

(defun g2c-lote-a-cases ()
  (g2c-arm-begin "lote_a")
  ;; ---- engine/gfx/hw/gs.gc y texture.gc: formatos y bloques ----
  (dotimes (i 10)
    (let ((p (the-as gs-psm (-> *g2c-psms* i))))
      (g2c-arm "psm-size" psm-size p)
      (g2c-arm "psm-page-height" psm-page-height p)
      (g2c-arm "texture-bpp" texture-bpp p)
      ;; con un formato que no tratan llaman a format (kernel): solo los que tratan
      (when (< i 6) ;; ct32 ct24 ct16 ct16s mt8 mt4
        (g2c-arm "gs-page-width" gs-page-width p)
        (g2c-arm "gs-page-height" gs-page-height p)
        (g2c-arm "gs-block-width" gs-block-width p)
        (g2c-arm "gs-block-height" gs-block-height p))))
  (let ((p32 (the-as gs-psm 0)) (p8 (the-as gs-psm 19)) (p4 (the-as gs-psm 20)))
    (g2c-arm "texture-qwc-32" texture-qwc 256 128 p32)
    (g2c-arm "texture-qwc-8" texture-qwc 64 32 p8)
    (g2c-arm "texture-qwc-4" texture-qwc 33 17 p4)
    (g2c-arm "gs-find-block-32" gs-find-block 3 5 p32)
    (g2c-arm "gs-find-block-8" gs-find-block 7 2 p8)
    (g2c-arm "gs-find-block-4" gs-find-block 1 6 p4)
    (g2c-arm "gs-largest-block-32" gs-largest-block 256 256 p32)
    (g2c-arm "gs-largest-block-4" gs-largest-block 64 128 p4)
    (g2c-arm "gs-blocks-used-32" gs-blocks-used 128 64 p32)
    (g2c-arm "gs-blocks-used-8" gs-blocks-used 512 256 p8)
    (g2c-arm "gs-blocks-used-4" gs-blocks-used 16 16 p4))
  (g2c-arm "texture-mip->segment" texture-mip->segment 2 4)
  (g2c-arm "texture-mip->segment-2" texture-mip->segment 0 1)
  ;; ---- paquetes GIF y draw-context ----
  (let ((pk (the-as gif-packet (g2c-basic-alloc 64 gif-packet))))
    (g2c-arm "open-gif-packet" open-gif-packet pk)
    (g2c-arm-none "add-reg-gif-packet" add-reg-gif-packet pk 6 #x123456789)
    (g2c-arm-none "add-reg-gif-packet-2" add-reg-gif-packet pk 14 -77)
    (g2c-arm "close-gif-packet" close-gif-packet pk 1))
  (let ((dc (the-as draw-context (g2c-basic-alloc 48 draw-context))))
    (g2c-arm-none "draw-context-set-xy" draw-context-set-xy dc 320 -224))
  ;; ---- engine/dma: buffers y buckets ----
  (let ((buf (the-as dma-buffer (g2c-basic-alloc 1024 dma-buffer))))
    (g2c-arm "dma-buffer-inplace-new" dma-buffer-inplace-new buf 960)
    (g2c-arm "dma-buffer-length" dma-buffer-length buf)
    (g2c-arm "dma-buffer-free" dma-buffer-free buf)
    (g2c-arm "dma-buffer-add-buckets" dma-buffer-add-buckets buf 9)
    (g2c-arm "dma-buffer-length-2" dma-buffer-length buf)
    (g2c-arm "dma-buffer-free-2" dma-buffer-free buf)
    (let ((tags (the-as (pointer dma-tag) (g2c-alloc 64))))
      (g2c-arm-none "dma-bucket-insert-tag" dma-bucket-insert-tag
                    (the-as (inline-array dma-bucket) (-> buf data)) (the-as bucket-id 3)
                    (the-as pointer tags) tags)))
  ;; ---- dinámica y depth-cue ----
  (g2c-arm "time-to-apex" time-to-apex 40960.0 -544768.0)
  (g2c-arm "time-to-apex-0" time-to-apex 0.0 -544768.0)
  (g2c-arm "time-to-ground" time-to-ground 40960.0 544768.0 12288.0)
  (g2c-arm "time-to-ground-2" time-to-ground -1000.0 300000.0 4096.0)
  (g2c-arm "depth-cue-calc-z" depth-cue-calc-z 0.5)
  (g2c-arm "depth-cue-calc-z-2" depth-cue-calc-z 0.0)
  ;; ---- matrices y vectores del océano ----
  (let ((ma (g2c-mat 1.0 0.5 -0.25 0.125 2.0 -1.5 3.0 0.75))
        (mb (g2c-mat -0.5 1.25 2.0 0.25 -3.0 1.0 0.5 -2.0))
        (mo (the-as matrix (g2c-alloc 64)))
        (va (g2c-vec 1.5 -2.0 3.0 1.0))
        (vo (the-as vector (g2c-alloc 16))))
    (g2c-arm "ocean-matrix*!" ocean-matrix*! mo ma mb)
    (g2c-arm "ocean-vector-matrix*!" ocean-vector-matrix*! vo va ma))
  (dotimes (i 4)
    (let ((a (the-as uint (+ (* i 3) 1))) (b (the-as uint (* i 7))))
      (g2c-arm "ocean-trans-camera-masks-bit?" ocean-trans-camera-masks-bit? a b)
      ;; (ocean-trans-mask-ptrs-bit? no: lee punteros por fotograma de *ocean-work*)
      (g2c-arm "ocean-mid-camera-masks-bit?" ocean-mid-camera-masks-bit? a b)))
  ;; ---- luces ----
  (let ((la (the-as light-group (g2c-alloc 192)))
        (lb (the-as light-group (g2c-alloc 192)))
        (lo (the-as light-group (g2c-alloc 192))))
    (dotimes (i 4)
      (let ((x (the float i)))
        (set-vector! (-> la lights i direction) (- 1.0 (* 0.25 x)) (* 0.5 x) 0.25 0.0)
        (set-vector! (-> lb lights i direction) (* -0.3 x) 1.0 (- 0.5 (* 0.1 x)) 0.0)
        (set-vector! (-> la lights i color) 0.2 (* 0.3 x) 0.9 1.0)
        (set-vector! (-> lb lights i color) 0.8 0.1 (* 0.2 x) 0.5)
        (set-vector! (-> la lights i levels) 0.75 0.5 0.0 0.0)
        (set-vector! (-> lb lights i levels) 0.25 1.0 0.0 0.0)))
    (g2c-arm "light-slerp" light-slerp (-> lo dir0) (-> la dir0) (-> lb dir0) 0.3)
    (g2c-arm "light-group-slerp" light-group-slerp lo la lb 0.65))
  ;; ---- sprites y viento ----
  (let ((q (the-as quaternion (g2c-vec 0.1 0.7 -0.3 0.6)))
        (sd (the-as sprite-vec-data-3d (g2c-alloc 48)))
        (qo (the-as quaternion (g2c-alloc 16))))
    (g2c-arm "sprite-set-3d-quaternion!" sprite-set-3d-quaternion! sd q)
    (g2c-arm "sprite-get-3d-quaternion!" sprite-get-3d-quaternion! qo sd))
  (let ((w1 (g2c-vec 12345.0 0.0 -67890.0 1.0)) (w2 (g2c-vec -409600.0 100.0 819200.0 1.0)))
    (g2c-arm "wind-get-hashed-index" wind-get-hashed-index w1)
    (g2c-arm "wind-get-hashed-index-2" wind-get-hashed-index w2))
  ;; ---- math-camera y drawable: usan *math-camera* de la imagen ----
  (let ((p1 (g2c-vec 1000.0 2000.0 -50000.0 1.0))
        (p2 (g2c-vec -8000.0 500.0 30000.0 1.0))
        (o1 (the-as vector (g2c-alloc 16)))
        (o2 (the-as vector4w (g2c-alloc 16)))
        (s1 (the-as sphere (g2c-vec 0.0 0.0 0.0 4096.0)))
        (s2 (the-as sphere (g2c-vec 1000000.0 0.0 0.0 10.0))))
    (g2c-arm "transform-point-vector!" transform-point-vector! o1 p1)
    (g2c-arm "transform-point-vector!-2" transform-point-vector! o1 p2)
    (g2c-arm "transform-point-qword!" transform-point-qword! o2 p1)
    (g2c-arm "sphere-in-view-frustum?" sphere-in-view-frustum? s1)
    (g2c-arm "sphere-in-view-frustum?-2" sphere-in-view-frustum? s2)
    (g2c-arm "line-in-view-frustum?" line-in-view-frustum? p1 p2)
    (g2c-arm "sphere-cull" sphere-cull (the-as vector s1))
    (g2c-arm "guard-band-cull" guard-band-cull (the-as vector s2)))
  (g2c-arm-end))

(g2c-lote-a-cases)
